CREATE DATABASE Estacionamento;

USE estacionamento;

CREATE TABLE endereco(
id_end INT NOT NULL AUTO_INCREMENT UNIQUE,
rua VARCHAR(30) NOT NULL,
bairro VARCHAR(30) NOT NULL,
numero INT,
cidade VARCHAR(20),
PRIMARY KEY(id_end)
);

CREATE TABLE cliente(
cpf VARCHAR(15) NOT NULL,
nome VARCHAR(30) NOT NULL,
email VARCHAR(70) NOT NULL,
telefone VARCHAR(15) NOT NULL,
cnh VARCHAR(10) NOT NULL,
senha VARCHAR(8) NOT NULL,
credito DOUBLE NOT NULL,
PRIMARY KEY (cpf),
id_end INT NOT NULL,
FOREIGN KEY(id_end) REFERENCES endereco(id_end)
);

CREATE TABLE veiculo(
placa VARCHAR(10) NOT NULL UNIQUE,
cpf VARCHAR(15) NOT NULL,
cor VARCHAR(15),
modelo VARCHAR(30) NOT NULL,
anoDeFabricacao VARCHAR(4),
PRIMARY KEY (placa),
FOREIGN KEY (cpf) REFERENCES cliente(cpf)
);

CREATE TABLE funcionario(
id_f INT NOT NULL AUTO_INCREMENT UNIQUE,
cpf VARCHAR(15) NOT NULL,
nome VARCHAR(50) NOT NULL,
email VARCHAR(70) NOT NULL,
telefone VARCHAR(15) NOT NULL,
senha VARCHAR(10) NOT NULL,
PRIMARY KEY (id_f),
id_end INT NOT NULL,
FOREIGN KEY(id_end) REFERENCES endereco(id_end)
);

CREATE TABLE atendimento(
id_atendimento INT NOT NULL AUTO_INCREMENT UNIQUE,
cpf VARCHAR(15) NOT NULL,
id_f INT NOT NULL,
dataAtendimento DATE NOT NULL,
horaAtendimento TIME NOT NULL,
PRIMARY KEY (id_atendimento),
FOREIGN KEY (cpf) REFERENCES cliente(cpf),
FOREIGN KEY (id_f) REFERENCES funcionario(id_f)
);

CREATE TABLE vaga(
numeroVaga INT NOT NULL UNIQUE,
tipo VARCHAR(10) NOT NULL,
statusVaga VARCHAR(15) NOT NULL,
PRIMARY KEY (numeroVaga)
);

CREATE TABLE reserva(
id_reserva INT NOT NULL AUTO_INCREMENT UNIQUE,
cpf VARCHAR(15) NOT NULL,
horaInicio TIME NOT NULL,
dataInicio DATE NOT NULL,
horaFim TIME NOT NULL,
dataFim DATE NOT NULL,
numeroVaga INT NOT NULL,
PRIMARY KEY (id_reserva),
FOREIGN KEY (numeroVaga) REFERENCES vaga(numeroVaga),
FOREIGN KEY (cpf) REFERENCES cliente(cpf)
);

CREATE TABLE estacionamentoT(
id_est INT NOT NULL AUTO_INCREMENT UNIQUE,
placa VARCHAR(10) NOT NULL,
numeroVaga INT NOT NULL,
horaInicio TIME NOT NULL,
dataInicio DATE NOT NULL,
horaFim TIME NOT NULL,
dataFim DATE NOT NULL,
id_reserva INT NOT NULL,
PRIMARY KEY (id_est),
FOREIGN KEY (id_reserva) REFERENCES reserva(id_reserva),
FOREIGN KEY (placa) REFERENCES veiculo(placa),
FOREIGN KEY (numeroVaga) REFERENCES vaga(numeroVaga)
);

ALTER TABLE estacionamentoT ADD metodo VARCHAR(15) NOT NULL;
ALTER TABLE estacionamentoT ADD valor DOUBLE NOT NULL;
